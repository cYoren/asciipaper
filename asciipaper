def engine_script(options):
    """lib/asciipaper.js (frame pacing, pointer, settings, renderer) with the user's options."""
    return f"window.__asciipaperOptions = {json.dumps(options)};\n" + (LOCAL / "lib/asciipaper.js").read_text()


def load_engine_options():
    try:
        saved = json.loads(ENGINE_CONFIG.read_text())
        return {key: value for key, value in saved.items() if key in ENGINE_DEFAULTS}
    except (OSError, ValueError, AttributeError):
        return {}


def ensure_user_api():
    source = LOCAL / "lib/asciipaper.js"
    if source.is_file():
        destination = USER_WALLPAPERS / "lib/asciipaper.js"
        destination.parent.mkdir(parents=True, exist_ok=True)
        # Keep user wallpapers on the current runtime so they also work in a plain browser.
        if not destination.exists() or destination.read_bytes() != source.read_bytes():
            shutil.copyfile(source, destination)


def app_process_cpu(root_pid, previous):
    """Return this app and its WebKit child processes' CPU use, as % of one core."""
    processes = {}
    for entry in Path("/proc").iterdir():
        if not entry.name.isdigit():
            continue
        try:
            fields = (entry / "stat").read_text().rsplit(")", 1)[1].split()
            processes[int(entry.name)] = (int(fields[1]), int(fields[11]) + int(fields[12]))
        except (OSError, ValueError, IndexError):
            continue
    children = {pid: [] for pid in processes}
    for pid, (parent, _) in processes.items():
        if parent in children:
            children[parent].append(pid)
    owned = {root_pid}
    for pid in tuple(owned):
        pending = [pid]
        while pending:
            parent = pending.pop()
            for child in children.get(parent, ()):
                if child not in owned:
                    owned.add(child); pending.append(child)
    ticks = sum(processes[pid][1] for pid in owned if pid in processes)
    now = time.monotonic()
    old_time, old_ticks = previous
    if old_time is None:
        return 0.0, (now, ticks)
    percent = max(0.0, (ticks - old_ticks) / os.sysconf("SC_CLK_TCK") / max(now - old_time, .01) * 100)
    return percent, (now, ticks)


class _WallpaperAssets(HTMLParser):
    """Collect static local references from the portable HTML wallpaper."""
    def __init__(self):
        super().__init__()
        self.paths = []

    def handle_starttag(self, tag, attrs):
        attrs = dict(attrs)
        for key in (("src", "poster") if tag in {"video", "source"} else
                    ("src",) if tag in {"script", "img", "audio"} else
                    ("href",) if tag == "link" else ()):
            if attrs.get(key):
                self.paths.append(attrs[key])


def local_assets(source):
    """Return the local files referenced by an HTML wallpaper."""
    source = Path(source).resolve()
    base = source.parent
    found, queue = set(), [source]
    while queue:
        current = queue.pop()
        if current in found:
            continue
        found.add(current)
        try:
            text = current.read_text(encoding="utf-8")
        except (OSError, UnicodeError):
            continue
        references = []
        if current.suffix.lower() in {".html", ".htm"}:
            parser = _WallpaperAssets(); parser.feed(text)
            references.extend(parser.paths)
            references.extend(re.findall(r"url\(['\"]?([^)'\"]+)", text, re.IGNORECASE))
            references.extend(re.findall(r"(?:\bfrom\s*|\bimport\s*\(?\s*)['\"]([^'\"]+)['\"]", text))
        elif current.suffix.lower() == ".css":
            references.extend(re.findall(r"url\(['\"]?([^)'\"]+)", text, re.IGNORECASE))
            references.extend(re.findall(r"@import\s+['\"]([^'\"]+)", text, re.IGNORECASE))
        elif current.suffix.lower() in {".js", ".mjs"}:
            references.extend(re.findall(r"(?:\bfrom\s*|\bimport\s*\(?\s*)['\"]([^'\"]+)['\"]", text))
        for reference in references:
            reference = reference.strip()
            if not reference or reference.startswith(("#", "/", "//")):
                continue
            parsed = urlparse(reference)
            if parsed.scheme:
                continue
            asset = (current.parent / unquote(parsed.path)).resolve()
            try:
                asset.relative_to(base)
            except ValueError:
                continue
            if asset.is_file():
                queue.append(asset)
    found.discard(source)
    core = base / "lib/asciify-core.js"
    license_file = base / "lib/asciify-engine-MIT.txt"
    if core in found and license_file.is_file():
        found.add(license_file.resolve())
    return sorted(found)


def copy_local_assets(source, destination_root):
    """Copy an HTML wallpaper's dependency tree without overwriting files."""
    source = Path(source).resolve()
    destination_root = Path(destination_root)
    assets = local_assets(source)
    conflicts = []
    for asset in assets:
        destination = destination_root / asset.relative_to(source.parent)
        if destination.exists() and destination.read_bytes() != asset.read_bytes():
            conflicts.append(str(asset.relative_to(source.parent)))
    if conflicts:
        raise ValueError("asset name collision: " + ", ".join(conflicts))
    for asset in assets:
        destination = destination_root / asset.relative_to(source.parent)
        destination.parent.mkdir(parents=True, exist_ok=True)
        if not destination.exists():
            shutil.copy2(asset, destination)


# ---- Wallpaper specs: JSON that describes a wallpaper (a shader, or media through lib/media.glsl, plus
# its look). asciipaper-engine runs them natively; spec_html() makes the web version beside them.
NAME_RE = r"[A-Za-z0-9][A-Za-z0-9 _-]{0,47}"
CHARSETS = {
    "classic": " .:-=+*#%@",
    "detailed": " .'`^\",:;Il!i><~+_-?][}{1)(|\\/tfjrxnuvczXYUJCLQ0OZmwqpdbkhao*#MW&8%B@$",
    "blocks": " ░▒▓█",
    "braille": " ⠁⠃⠇⡇⣇⣧⣷⣿",
    "dots": " ·•●",
    "letters": " .ilLCFTYASMW",
    "asciify": " .:-=+ASCIIFY#@",
    "binary": " 01",
}
MAX_FRAMES, FRAME_WIDTH, MAX_FPS = 600, 256, 30


def spec_file(target):
    """The spec JSON a target names (a library name or a .json path), or None."""
    if re.fullmatch(NAME_RE, target) and (USER_WALLPAPERS / f"{target}.json").is_file():
        return USER_WALLPAPERS / f"{target}.json"
    path = Path(target).expanduser()
    return path.resolve() if path.suffix.lower() == ".json" and path.is_file() else None


def read_spec(path):
    try:
        spec = json.loads(Path(path).read_text(encoding="utf-8"))
        if isinstance(spec, dict):
            return spec
    except (OSError, ValueError):
        pass
    sys.exit(f"asciipaper: {path} is not a wallpaper spec (a JSON object)")


def spec_shader(spec, base):
    """GLSL source and its defaults (from a `// defaults: {...}` first line)."""
    shader = spec.get("shader", "media" if spec.get("media") else None)
    if not isinstance(shader, str):
        sys.exit('asciipaper: a spec needs "shader" or "media"')
    if "cell(" not in shader:
        path = LOCAL / "lib/media.glsl" if shader == "media" else base / shader
        shader = path.read_text(encoding="utf-8")
    defaults = {}
    if shader.startswith("// defaults:"):
        try:
            defaults = json.loads(shader.split("\n", 1)[0][len("// defaults:"):])
        except ValueError:
            pass
    return shader, defaults


def spec_html(path):
    """Write (if changed) and return the web version of a spec: <name>.html beside it."""
    path = Path(path).resolve()
    spec = read_spec(path)
    glsl, defaults = spec_shader(spec, path.parent)
    runtime = {key: spec[key] for key in ("charset", "cell", "aspect", "maxCells", "background", "font", "time", "period", "fill", "weight")
               if key in spec}
    runtime.update(glsl=glsl, uniforms={**defaults, **spec.get("uniforms", {})}, media=bool(spec.get("media")))
    media = ""
    if spec.get("media"):
        src = html.escape(spec["media"], quote=True)
        media = (f'<img id="asciipaper-media" src="{src}" alt="" hidden>' if Path(spec["media"]).suffix.lower() in
                 {".gif", ".png", ".jpg", ".jpeg", ".webp", ".bmp", ".avif", ".apng"} else
                 f'<video id="asciipaper-media" src="{src}" autoplay loop muted playsinline hidden></video>')
    title = html.escape(spec.get("title", path.stem))
    page = f"""<!doctype html>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title}</title>
<!-- Generated by asciipaper from {html.escape(path.name)}; edit that file instead. -->
<script src="./lib/asciipaper.js"></script>
<style>html,body{{margin:0;height:100%;overflow:hidden;background:{html.escape(spec.get("background", "#000000"))}}}</style>
{media}
<script>asciipaper.spec({json.dumps(runtime).replace("</", "<\\/")});</script>
"""
    output = path.with_suffix(".html")
    if not output.exists() or output.read_text(encoding="utf-8") != page:
        output.write_text(page, encoding="utf-8")
    if not (output.parent / "lib/asciipaper.js").exists() and (LOCAL / "lib/asciipaper.js").is_file():
        (output.parent / "lib").mkdir(exist_ok=True)
        shutil.copyfile(LOCAL / "lib/asciipaper.js", output.parent / "lib/asciipaper.js")
    return output


def fetch_media(source, folder):
    """Download a media URL into folder; X/Twitter posts go through the public fxtwitter API."""
    headers = {"User-Agent": "asciipaper (https://github.com/cYoren/asciipaper)"}
    post = re.match(r"https?://(?:www\.)?(?:x|twitter|fxtwitter|vxtwitter)\.com/(\w+)/status/(\d+)", source)
    title = None
    if post:
        request = urllib.request.Request(f"https://api.fxtwitter.com/{post[1]}/status/{post[2]}", headers=headers)
        with urllib.request.urlopen(request, timeout=30) as response:
            tweet = json.load(response).get("tweet", {})
        media = (tweet.get("media") or {}).get("all") or []
        if not media:
            sys.exit("asciipaper: that post has no picture, GIF or video")
        source = media[0]["url"]
        # Fancy Unicode letters (ＴＨＥ, 𝑵𝒐𝒃𝒍𝒆) fold to plain ones; the post's text names it, else its author.
        text = unicodedata.normalize("NFKC", re.sub(r"https?://\S+", "", tweet.get("text") or "")).strip()
        author = unicodedata.normalize("NFKC", tweet.get("author", {}).get("name") or post[1]).strip()
        title = " ".join(text.split()) if 0 < len(text) <= 40 else author or post[1]
    name = Path(urlparse(source).path).name or "media"
    destination = Path(folder) / name
    request = urllib.request.Request(source, headers=headers)
    with urllib.request.urlopen(request, timeout=60) as response, open(destination, "wb") as out:
        shutil.copyfileobj(response, out)
    return destination, title


def media_info(path):
    """(width, height, fps, frame count or None for 'until the end') of a picture, GIF or video."""
    probe = subprocess.run(["ffprobe", "-v", "error", "-select_streams", "v:0", "-show_entries",
                            "stream=width,height,avg_frame_rate,nb_frames:format=duration", "-of", "json", str(path)],
                           capture_output=True, text=True)
    try:
        info = json.loads(probe.stdout)
        stream = info["streams"][0]
        width, height = int(stream["width"]), int(stream["height"])
    except (ValueError, KeyError, IndexError):
        sys.exit(f"asciipaper: can't read {path} as a picture, GIF or video")
    num, _, den = stream.get("avg_frame_rate", "0/1").partition("/")
    fps = float(num) / float(den or 1) if float(den or 1) else 0
    duration = float(info.get("format", {}).get("duration") or 0)
    still = fps <= 0 or duration == 0 or stream.get("nb_frames") == "1"
    return width, height, (0 if still else fps), (1 if still else None)


def make_frames(media):
    """Decode media into <media>.frames for asciipaper-engine: 'APF1', u32 width, height, count,
    fps x 1000, then RGB frames. Small on purpose: the character grid is only a few hundred cells wide."""
    if not shutil.which("ffmpeg"):
        sys.exit("asciipaper: porting pictures, GIFs and videos needs ffmpeg (sudo pacman -S ffmpeg)")
    width, height, fps, count = media_info(media)
    w = min(FRAME_WIDTH, width) // 2 * 2 or 2
    h = max(2, round(w * height / width / 2) * 2)
    fps = min(fps, MAX_FPS)
    vf = f"scale={w}:{h}:flags=area" + (f",fps={fps:.3f}" if fps else "")
    decode = subprocess.run(["ffmpeg", "-v", "error", "-i", str(media), "-vf", vf, "-frames:v", str(count or MAX_FRAMES),
                             "-f", "rawvideo", "-pix_fmt", "rgb24", "-"], capture_output=True)
    frames = len(decode.stdout) // (w * h * 3)
    if decode.returncode or not frames:
        sys.exit(f"asciipaper: ffmpeg could not decode {media}: {decode.stderr.decode(errors='replace').strip()}")
    output = Path(f"{media}.frames")
    with open(output, "wb") as out:
        out.write(b"APF1" + struct.pack("<4I", w, h, frames, round(fps * 1000)))
        out.write(decode.stdout[:frames * w * h * 3])
    rgb = decode.stdout[:frames * w * h * 3]
    return (output, *look(rgb))


def look(rgb):
    """A starting look for media.glsl, measured from the frames: stretch the 2nd..98th percentile
    luminance to the full range, give the dense characters to the subject (inverting pictures that
    are mostly light), and take the tint and background from the picture's own average colour."""
    step = max(1, len(rgb) // 3 // 20000) * 3   # ~20k samples is plenty
    samples = range(0, len(rgb) - 2, step)
    luma = sorted(0.299 * rgb[i] + 0.587 * rgb[i + 1] + 0.114 * rgb[i + 2] for i in samples)
    lo, hi = luma[len(luma) * 2 // 100] / 255, luma[len(luma) * 98 // 100] / 255
    contrast = min(4.0, 1 / max(hi - lo, 0.25))
    median = (luma[len(luma) // 2] / 255 - lo) * contrast
    mean = [sum(rgb[i + c] for i in samples) / len(samples) for c in range(3)]
    peak = max(mean) or 1
    hexed = lambda scale: "#" + "".join(f"{min(255, round(v / peak * scale)):02x}" for v in mean)
    uniforms = {"contrast": round(contrast, 2), "brightness": round(contrast * (0.5 - lo) - 0.5, 2),
                "tint": hexed(255)}
    if median > 0.55:
        uniforms["invert"] = 1
    return uniforms, hexed(18)


def import_media(source, name=None):
    """Port a picture, GIF or video (path or URL) into USER_WALLPAPERS as <name>.json + media."""
    media_dir = USER_WALLPAPERS / "media"
    media_dir.mkdir(parents=True, exist_ok=True)
    title = None
    with tempfile.TemporaryDirectory(prefix="asciipaper-import-") as temporary:
        if re.match(r"https?://", source):
            print("Downloading…", file=sys.stderr)
            path, title = fetch_media(source, temporary)
        else:
            path = Path(source).expanduser()
            if not path.is_file():
                sys.exit(f"asciipaper: no such file: {source}")
        stem = name or re.sub(r"[^A-Za-z0-9 _-]+", "", title or path.stem).strip()[:40] or "ported"
        stem = re.sub(r"\s*-\s*", "-", stem)
        stem = re.sub(r"\s+", "-", stem).lower()
        name, index = stem, 2
        while (USER_WALLPAPERS / f"{name}.json").exists() or (USER_WALLPAPERS / f"{name}.html").exists() or name in PRESETS:
            name, index = f"{stem}-{index}", index + 1
        media = media_dir / f"{name}{path.suffix.lower() or '.bin'}"
        shutil.copyfile(path, media)
    try:
        _, uniforms, background = make_frames(media)
    except SystemExit:
        media.unlink(missing_ok=True)
        raise
    spec = {"title": title or name, "media": f"media/{media.name}", "charset": CHARSETS["detailed"],
            "cell": 7, "aspect": 0.55, "weight": 700, "fill": 0.25, "background": background, "uniforms": uniforms}
    path = USER_WALLPAPERS / f"{name}.json"
    path.write_text(json.dumps(spec, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    ensure_user_api()
    spec_html(path)
    return name


THUMBNAILS = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "asciipaper/thumbnails"
_thumbnail_slots = threading.Semaphore(2)


def request_thumbnail(name, callback):
    """Render name offscreen with asciipaper-engine (cached until its files change); callback(path)
    runs on a worker thread. Wallpapers the engine can't draw (HTML) get no thumbnail."""
    args = engine_args(name)
    if not args:
        return
    files = [Path(args[0])]
    spec = spec_file(name)
    if spec:
        data = read_spec(spec)
        files.append(spec)
        if isinstance(data.get("media"), str):
            files.append(spec.parent / f"{data['media']}.frames")
        if isinstance(data.get("shader"), str) and data["shader"].endswith(".glsl"):
            files.append(spec.parent / data["shader"])
    stamp = "-".join(str(int(f.stat().st_mtime)) for f in files if f.exists())
    path = THUMBNAILS / f"{re.sub(r'[^A-Za-z0-9_-]', '_', name)}-{zlib.crc32(stamp.encode()):08x}.png"
    if path.exists():
        callback(path)
        return
    def work():
        with _thumbnail_slots:
            THUMBNAILS.mkdir(parents=True, exist_ok=True)
            temporary = path.with_suffix(".tmp.png")
            try:
                subprocess.run([*args, "--snapshot", str(temporary), "--size", "960x540", "--seconds", "0.6" if spec else "4"],
                               env=engine_env(), timeout=60, capture_output=True)
            except (OSError, subprocess.TimeoutExpired):
                return
            if temporary.exists():
                temporary.replace(path)
                callback(path)
    threading.Thread(target=work, daemon=True).start()


def render_video(target, output, seconds=None, size=None, fps=30):
    """Record a wallpaper to a video or GIF (by output's extension) with asciipaper-engine's offscreen
    mode: for video-wallpaper apps (GNOME extensions, phones, Wallpaper Engine) and for sharing."""
    args = engine_args(target)
    if not args:
        sys.exit("asciipaper: render works with the built-in presets and with ported or shader wallpapers")
    if not shutil.which("ffmpeg"):
        sys.exit("asciipaper: rendering needs ffmpeg (sudo pacman -S ffmpeg)")
    output = Path(output).expanduser().resolve()
    kind = output.suffix.lower()
    if kind not in {".mp4", ".webm", ".gif", ".mkv", ".mov"}:
        sys.exit("asciipaper: render to .mp4, .webm, .mkv, .mov or .gif")
    size = size or ("960x540" if kind == ".gif" else "1920x1080")
    if not re.fullmatch(r"\d{2,5}x\d{2,5}", size):
        sys.exit("asciipaper: --size is WIDTHxHEIGHT, e.g. 1920x1080")
    fps = min(fps, 25) if kind == ".gif" else fps
    spec = spec_file(target)
    media = spec and read_spec(spec).get("media")
    if seconds is None:   # a ported loop: whole loops, at least 3 s; everything else: 10 s
        seconds = 10.0
        frames = spec.parent / f"{media}.frames" if isinstance(media, str) else None
        if frames and frames.is_file():
            header = frames.read_bytes()[:20]
            count, rate = struct.unpack("<4I", header[4:20])[2:]
            if rate and count > 1:
                loop = count / (rate / 1000)
                seconds = loop * max(1, math.ceil(3 / loop))
    width, height = map(int, size.split("x"))
    encode = {".gif": ["-filter_complex", "split[a][b];[a]palettegen=stats_mode=diff[p];[b][p]paletteuse=dither=bayer:bayer_scale=3",
                       "-loop", "0"],
              ".webm": ["-c:v", "libvpx-vp9", "-b:v", "0", "-crf", "28", "-pix_fmt", "yuv420p", "-row-mt", "1"]}.get(
        kind, ["-c:v", "libx264", "-preset", "slow", "-crf", "18", "-pix_fmt", "yuv420p", "-movflags", "+faststart"])
    engine = subprocess.Popen([*args, "--snapshot", "-", "--size", size, "--seconds", f"{seconds:.3f}", "--record", str(fps),
                               "--warmup", "0" if spec else "3"], stdout=subprocess.PIPE, env=engine_env())
    ffmpeg = subprocess.run(["ffmpeg", "-v", "error", "-y", "-f", "rawvideo", "-pix_fmt", "rgba", "-s", f"{width}x{height}",
                             "-r", str(fps), "-i", "-", *encode, str(output)], stdin=engine.stdout, capture_output=True)
    engine.stdout.close()
    if engine.wait() or ffmpeg.returncode:
        sys.exit(f"asciipaper: rendering failed: {ffmpeg.stderr.decode(errors='replace').strip() or 'engine error'}")
    return output


def export_web(target, destination=None):
    """One ZIP that runs on Windows and macOS: index.html + assets, with the settings bridges for
    Wallpaper Engine (project.json) and Lively (LivelyInfo.json); Plash on macOS opens index.html."""
    url = resolve(target)
    parsed = urlparse(url)
    if parsed.scheme != "file":
        sys.exit("asciipaper: only local wallpapers can be exported")
    source = Path(unquote(parsed.path)).resolve()
    title = re.sub(r"[^A-Za-z0-9 _-]", "", source.stem).strip() or "ASCII Wallpaper"
    output = Path(destination).expanduser() if destination else Path.cwd() / f"{title}.asciipaper.zip"
    output = output.resolve()
    output.parent.mkdir(parents=True, exist_ok=True)
    properties = {
        "fps": ("Frame rate", 10, 60, 1, 24), "idleFps": ("Frame rate when idle", 1, 60, 1, 12),
        "quality": ("Render quality", 0.5, 2, 0.1, 1), "pointer": ("Pointer response", 0, 2, 0.1, 1)}
    bridge = ("<script>" + engine_script(ENGINE_DEFAULTS) + """
window.livelyPropertyListener = (name, value) => asciipaper.set({[name]: Number(value)});
window.wallpaperPropertyListener = {applyUserProperties(p) {
  for (const [k, v] of Object.entries(p)) if (v && 'value' in v) asciipaper.set({[k]: Number(v.value)});
}};</script>""")
    with tempfile.TemporaryDirectory(prefix="asciipaper-export-") as temporary:
        root = Path(temporary)
        page = source.read_text(encoding="utf-8")
        head = re.search(r"<head\b[^>]*>", page, re.IGNORECASE)
        doctype = re.search(r"<!doctype\b[^>]*>", page, re.IGNORECASE)
        at = head.end() if head else doctype.end() if doctype else 0
        (root / "index.html").write_text(page[:at] + bridge + page[at:], encoding="utf-8")
        for asset in local_assets(source):
            bundled = root / asset.relative_to(source.parent)
            bundled.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(asset, bundled)
        info = {"AppVersion": "2.0.7.0", "Title": title, "Thumbnail": None, "Preview": None,
                "Desc": "Interactive ASCII wallpaper made with asciipaper.", "Author": None, "License": None,
                "Contact": "https://github.com/cYoren/asciipaper", "Type": 1, "FileName": "index.html",
                "Arguments": None, "IsAbsolutePath": False}
        (root / "LivelyInfo.json").write_text(json.dumps(info, indent=2) + "\n", encoding="utf-8")
        lively = {k: {"text": t, "type": "slider", "min": lo, "max": hi, "tick": step, "value": v}
                  for k, (t, lo, hi, step, v) in properties.items()}
        (root / "LivelyProperties.json").write_text(json.dumps(lively, indent=2) + "\n", encoding="utf-8")
        project = {"file": "index.html", "title": title, "type": "web",
                   "description": "Interactive ASCII wallpaper made with asciipaper (https://github.com/cYoren/asciipaper).",
                   "general": {"properties": {k: {"order": i, "text": t, "type": "slider", "min": lo, "max": hi,
                                                  "value": v, "fraction": step < 1, "precision": 1 if step < 1 else 0}
                                              for i, (k, (t, lo, hi, step, v)) in enumerate(properties.items())}}}
        (root / "project.json").write_text(json.dumps(project, indent=2) + "\n", encoding="utf-8")
        (root / "README.txt").write_text(
            f"{title}: an interactive ASCII wallpaper made with asciipaper.\n\n"
            "Windows, Wallpaper Engine: Create Wallpaper > Open wallpaper > choose project.json.\n"
            "Windows, Lively Wallpaper: drag this ZIP onto Lively.\n"
            "macOS, Plash: unzip, then Add Website > the index.html file.\n"
            "Linux: asciipaper import is not needed; open index.html with `asciipaper`.\n", encoding="utf-8")
        with zipfile.ZipFile(output, "w", compression=zipfile.ZIP_DEFLATED) as archive:
            for file in root.rglob("*"):
                if file.is_file():
                    archive.write(file, file.relative_to(root))
    return output


def resolve(target):
    if target in PRESETS:
        return PRESETS[target]
    if "://" in target:
        return target
    spec = spec_file(target)
    if spec:
        return spec_html(spec).as_uri()
    user_preset = USER_WALLPAPERS / f"{target}.html"
    if re.fullmatch(NAME_RE, target) and user_preset.is_file():
        return user_preset.resolve().as_uri()
    path = Path(target).expanduser().resolve()
    if not path.is_file():
        sys.exit(f"asciipaper: no such preset, URL or file: {target}\nPresets: {', '.join(PRESETS)}")
    return path.as_uri()


def library():
    """Built-in presets, then the user's wallpapers (HTML and specs), by name."""
    names = set()
    if USER_WALLPAPERS.is_dir():
        names = {p.stem for pattern in ("*.html", "*.json") for p in USER_WALLPAPERS.glob(pattern)}
    return [*PRESETS, *sorted(names - set(PRESETS))]


HYPR = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "hypr" / os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
# Hyprland events after which a monitor may have gained or lost a fullscreen window.
HYPR_EVENTS = {"fullscreen", "workspace", "workspacev2", "focusedmon", "focusedmonv2", "openwindow", "closewindow",
               "movewindow", "movewindowv2", "activespecial", "activespecialv2", "monitoradded", "monitoraddedv2"}


def hyprland(request):
    with socket.socket(socket.AF_UNIX) as s:
        s.connect(str(HYPR / ".socket.sock"))
        s.sendall(request.encode())
        return json.loads(b"".join(iter(lambda: s.recv(65536), b"")))


def fullscreen_monitors():
    """Names of monitors whose active workspace shows a fullscreen window."""
    full = {w["id"] for w in hyprland("j/workspaces") if w.get("hasfullscreen")}
    return {m["name"] for m in hyprland("j/monitors") if m["activeWorkspace"]["id"] in full}


def watch_hyprland(callback):
    """Call callback (from a thread) after each relevant Hyprland event. No-op elsewhere."""
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return
    def loop():
        try:
            with socket.socket(socket.AF_UNIX) as s:
                s.connect(str(HYPR / ".socket2.sock"))
                for line in s.makefile(encoding="utf-8", errors="replace"):
                    if line.split(">>", 1)[0] in HYPR_EVENTS:
                        callback()
        except OSError:
            pass
    threading.Thread(target=loop, daemon=True).start()


def engine_binary():
    """asciipaper-engine in a source checkout, beside this script (installed), or on PATH."""
    here = Path(__file__).resolve().parent
    for candidate in (here / "native/asciipaper-engine", here / "asciipaper-engine"):
        if os.access(candidate, os.X_OK):
            return str(candidate)
    return shutil.which("asciipaper-engine")


def engine_args(target):
    """How asciipaper-engine draws target, or None if it can't (then WebKit does)."""
    binary = engine_binary()
    if not binary or FLATPAK:
        return None
    if target in NATIVE:
        return [binary, NATIVE[target]]
    spec = spec_file(target)
    return [binary, "--spec", str(spec), "--lib", str(LOCAL / "lib")] if spec else None


def uses_engine(target):
    return bool(engine_args(target)) and {**ENGINE_DEFAULTS, **load_engine_options()}["renderer"] != "web"


def engine_env():
    # The gtk4-layer-shell preload is for GTK; the engine speaks layer-shell itself. Like WebKit,
    # it belongs on the integrated GPU of a hybrid laptop (see run()).
    env = {key: value for key, value in os.environ.items() if key != "LD_PRELOAD"}
    if os.path.exists(MESA_EGL):
        env.setdefault("__EGL_VENDOR_LIBRARY_FILENAMES", MESA_EGL)
    return env


def start_engine(target):
    """Start asciipaper-engine; write pause lines to its stdin (see pause_line)."""
    return subprocess.Popen(engine_args(target), stdin=subprocess.PIPE, text=True, bufsize=1, env=engine_env())


def pause_line(engine, covered):
    try:
        engine.stdin.write("pause " + " ".join(sorted(covered)) + "\n")
    except (OSError, ValueError):
        pass   # the engine exited; its owner notices


def service_elsewhere():
    """True when the systemd service is running and this process is not it."""
    return (not FLATPAK and "INVOCATION_ID" not in os.environ and
            subprocess.run(["systemctl", "--user", "is-active", "--quiet", SERVICE]).returncode == 0)


def run_native(target):
    """The service with a native preset: just the engine, plus fullscreen pausing on Hyprland."""
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        args = engine_args(target)
        os.execve(args[0], args, engine_env())   # nothing else to do; no Python left running
    engine = start_engine(target)
    def refresh():
        try:
            pause_line(engine, fullscreen_monitors())
        except (OSError, ValueError, KeyError, TypeError):
            pass
    refresh()
    watch_hyprland(refresh)
    sys.exit(engine.wait())


def run(target, studio=False, preview=False):
    resolve(target)
    if not studio and not preview and uses_engine(target):
        if "INVOCATION_ID" not in os.environ and service_elsewhere():
            return set_wallpaper(target)   # switch the running service instead of stacking a second wallpaper
        return run_native(target)
    env = dict(os.environ)
    if os.path.exists(PRELOAD):
        env["LD_PRELOAD"] = PRELOAD
    # On hybrid laptops glvnd picks NVIDIA first, which keeps the dGPU awake all day and copies every
    # frame across GPUs. A wallpaper belongs on the integrated GPU; set the variable yourself to override.
    if os.path.exists(MESA_EGL):
        env.setdefault("__EGL_VENDOR_LIBRARY_FILENAMES", MESA_EGL)
        env.setdefault("GDK_DISABLE", "vulkan")   # GTK would otherwise start Vulkan on every GPU, NVIDIA included
    if env != os.environ:
        os.execve(sys.executable, [sys.executable, *sys.argv], env)
    try:
        import gi
        gi.require_version("Gdk", "4.0")
        gi.require_version("Gtk", "4.0")
        gi.require_version("WebKit", "6.0")
        gi.require_version("Gtk4LayerShell", "1.0")
        gi.require_version("Adw", "1")
        from gi.repository import Adw, Gdk, Gio, GLib, Graphene, Gtk, WebKit, Gtk4LayerShell as Layer
    except (ImportError, ValueError) as e:
        sys.exit(f"asciipaper: {e}\nInstall: sudo pacman -S --needed webkitgtk-6.0 python-gobject gtk4-layer-shell libadwaita")

    settings = WebKit.Settings(enable_webgl=True, hardware_acceleration_policy=WebKit.HardwareAccelerationPolicy.ALWAYS,
                               allow_file_access_from_file_urls=True, enable_developer_extras=preview,
                               enable_write_console_messages_to_stdout=preview)
    content = WebKit.UserContentManager()
    engine_options = {**ENGINE_DEFAULTS, **load_engine_options()}
    content.add_style_sheet(WebKit.UserStyleSheet(CSS, WebKit.UserContentInjectedFrames.ALL_FRAMES,
                                                  WebKit.UserStyleLevel.USER, None, None))

    def inject_engine():
        # Pages loaded later (preset switch, hot reload) start from the current options.
        content.remove_all_scripts()
        content.add_script(WebKit.UserScript.new(
            engine_script(engine_options), WebKit.UserContentInjectedFrames.ALL_FRAMES,
            WebKit.UserScriptInjectionTime.START, None, None))

    inject_engine()
    views, started = {}, False   # view -> monitor connector name
    engine = {"process": None, "target": None}   # a native wallpaper hosted by this process
    paused = set()
    layer_supported = Layer.is_supported()
    watched = {"monitor": None, "pending": 0}

    def js(view, code):
        view.evaluate_javascript(code, -1, None, None, None, None, None)

    def reload_views():
        watched["pending"] = 0
        for view in views:
            view.reload()
        return False

    def watch_folder(url):
        # Hot reload: saving the wallpaper (or anything beside it) reloads every view.
        watched["monitor"] = None
        if url.startswith("file://"):
            monitor = Gio.File.new_for_uri(url).get_parent().monitor_directory(Gio.FileMonitorFlags.NONE, None)
            def changed(*_):
                if not watched["pending"]:
                    watched["pending"] = GLib.timeout_add(250, reload_views)
            monitor.connect("changed", changed)
            watched["monitor"] = monitor

    def navigate(view, target):
        view.load_uri(resolve(target))

    def set_target(target):
        nonlocal current_target
        watch_folder(resolve(target))
        current_target = target
        CONFIG.parent.mkdir(parents=True, exist_ok=True)
        CONFIG.write_text(target + "\n")
        for view in views:
            navigate(view, target)

    def set_engine_options(options):
        engine_options.update(options)
        ENGINE_CONFIG.parent.mkdir(parents=True, exist_ok=True)
        ENGINE_CONFIG.write_text(json.dumps(engine_options, indent=2) + "\n")
        inject_engine()
        for view in views:
            js(view, f"window.asciipaper?.set({json.dumps(engine_options)})")

    def refresh_paused():
        """Stop rendering on monitors covered by a fullscreen window; resume when uncovered."""
        try:
            covered = fullscreen_monitors()
        except (OSError, ValueError, KeyError, TypeError):
            return False
        if engine["process"]:
            pause_line(engine["process"], covered)
        for view, name in views.items():
            if (name in covered) != (view in paused):
                paused.symmetric_difference_update({view})
                js(view, f"window.asciipaper?.set({{paused: {'true' if view in paused else 'false'}}})")
        return False

    def new_view(monitor_name):
        view = WebKit.WebView(settings=settings, user_content_manager=content)
        views[view] = monitor_name
        navigate(view, current_target)
        # A reloaded page starts unpaused; re-apply this monitor's state.
        view.connect("load-changed", lambda v, e: e == WebKit.LoadEvent.FINISHED and v in paused
                     and js(v, "window.asciipaper?.set({paused: true})"))
        return view

    def window(monitor):
        view = new_view(monitor.get_connector())
        win = Gtk.Window(application=app, child=view)
        Layer.init_for_window(win)
        Layer.set_layer(win, Layer.Layer.BACKGROUND)
        Layer.set_namespace(win, "asciipaper")
        Layer.set_monitor(win, monitor)
        for edge in Layer.Edge:
            if edge != Layer.Edge.ENTRY_NUMBER:
                Layer.set_anchor(win, edge, True)
        Layer.set_keyboard_mode(win, Layer.KeyboardMode.NONE)
        Layer.set_exclusive_zone(win, -1)
        win.present()

    def wallpaper_windows(app):
        nonlocal started
        if started:
            return
        started = True
        if not layer_supported:
            print("asciipaper: wallpaper mode needs Wayland with the wlr-layer-shell protocol; open Studio to edit or import wallpapers.", file=sys.stderr)
            return
        monitors = Gdk.Display.get_default().get_monitors()
        for m in monitors:
            window(m)
        # Monitors connected later receive their own background surface.
        monitors.connect("items-changed", lambda ms, pos, removed, added: [window(ms.get_item(pos + i)) for i in range(added)])
        refresh_paused()

    def close_views():
        nonlocal started
        for view in list(views):
            top = view.get_root()
            if isinstance(top, Gtk.Window):
                top.close()
        views.clear(); paused.clear()
        started = False

    def stop_engine():
        if engine["process"]:
            engine["process"].terminate(); engine["process"].wait()
            engine["process"] = engine["target"] = None
            app.release()

    def show_wallpaper(app):
        """Show current_target: on the native engine for built-in presets, in WebKit otherwise."""
        native = uses_engine(current_target)
        if service_elsewhere():
            # The service is drawing a native preset (a WebKit service would host this Studio).
            if native:
                close_views(); stop_engine()
                subprocess.run(["systemctl", "--user", "restart", SERVICE])
                return
            subprocess.run(["systemctl", "--user", "stop", SERVICE])
        if not native:
            stop_engine()
            wallpaper_windows(app)
            return
        close_views()
        if engine["target"] == engine_args(current_target) and engine["process"].poll() is None:
            return
        stop_engine()
        if not layer_supported:
            return
        engine["process"], engine["target"] = start_engine(current_target), engine_args(current_target)
        app.hold()   # keep running with no windows while the engine draws
        refresh_paused()

    def preview_window(app):
        win = Gtk.Window(application=app, child=new_view(None), title=f"asciipaper preview: {current_target}")
        win.set_default_size(1280, 720)
        win.present()

    current_target = target
    watch_folder(resolve(target))
    watch_hyprland(lambda: GLib.idle_add(refresh_paused))
    studio_window_ref = None
    unique = not preview and not os.environ.get("ASCIIPAPER_STUDIO_SNAPSHOT")
    app = Adw.Application(application_id="io.github.cyoren.asciipaper" if unique else None,
                          flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)

    def studio_window(app):
        nonlocal studio_window_ref
        if studio_window_ref is not None:
            studio_window_ref.present()
            return
        win = Adw.ApplicationWindow(application=app, title="asciipaper", default_width=1000, default_height=860)
        studio_window_ref = win
        def closed(*_):
            nonlocal studio_window_ref
            studio_window_ref = None
            return False
        win.connect("close-request", closed)
        toasts = Adw.ToastOverlay()
        toast = lambda text: toasts.add_toast(Adw.Toast(title=GLib.markup_escape_text(text), timeout=4))
        view = Adw.ToolbarView()
        header = Adw.HeaderBar()
        view.add_top_bar(header)
        if not layer_supported:
            banner = Adw.Banner(title="This desktop can't show live wallpapers (no layer-shell). You can still make and export them.",
                                revealed=True)
            view.add_top_bar(banner)

        # ---- Header: add (port media, links, HTML, shaders) and pause.
        menu = Gio.Menu()
        menu.append("Picture, GIF or video…", "win.port-file")
        menu.append("From a link (X, Twitter, any media URL)…", "win.port-link")
        section = Gio.Menu()
        section.append("HTML wallpaper…", "win.import-html")
        section.append("New shader wallpaper…", "win.new-shader")
        section.append("Open the wallpaper folder", "win.open-folder")
        menu.append_section(None, section)
        add_button = Gtk.MenuButton(icon_name="list-add-symbolic", menu_model=menu,
                                    tooltip_text="Add a wallpaper: port a picture, GIF or video, or start from code")
        add_button.add_css_class("suggested-action")
        header.pack_start(add_button)
        pause_button = Gtk.ToggleButton(icon_name="media-playback-pause-symbolic", tooltip_text="Pause the wallpaper")
        header.pack_end(pause_button)

        page = Adw.PreferencesPage()
        toasts.set_child(page)
        view.set_content(toasts)
        win.set_content(view)

        # ---- Gallery: every wallpaper as a card with a live-rendered thumbnail. Click to apply.
        gallery = Adw.PreferencesGroup(title="Wallpapers", description="Choose one to put it on your desktop. "
                                       "Drop a picture, GIF or video anywhere here to port it.")
        flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.SINGLE, homogeneous=True, max_children_per_line=3,
                           min_children_per_line=2, row_spacing=12, column_spacing=12, activate_on_single_click=True)
        gallery.add(flow)
        page.add(gallery)
        cards = {}   # name -> FlowBoxChild

        def card(name):
            picture = Gtk.Picture(content_fit=Gtk.ContentFit.COVER, can_shrink=True)
            picture.set_size_request(176, 99)
            overlay = Gtk.Overlay(child=picture, overflow=Gtk.Overflow.HIDDEN)
            overlay.add_css_class("card")
            placeholder = Gtk.Label(label="HTML" if not engine_args(name) else "…", opacity=0.5)
            placeholder.add_css_class("title-2")
            overlay.add_overlay(placeholder)
            label = Gtk.Label(label=name, ellipsize=3, xalign=0, margin_top=6)
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            box.append(overlay); box.append(label)
            child = Gtk.FlowBoxChild(child=box)
            child.wallpaper = name
            def shown(path):
                picture.set_filename(str(path)); placeholder.set_visible(False)
                return False
            request_thumbnail(name, lambda path: GLib.idle_add(shown, path))
            return child

        def refresh_gallery(select=None):
            for child in list(cards.values()):
                flow.remove(child)
            cards.clear()
            for name in library():
                if name == "asciify":   # an alias of fluid
                    continue
                cards[name] = card(name)
                flow.append(cards[name])
            chosen = cards.get(select or current_target)
            if chosen:
                flow.select_child(chosen)

        def apply(name):
            set_target(name)
            show_wallpaper(app)
            pause_button.set_active(False)
            load_look()
            toast(f"{name} is on your desktop" if layer_supported else f"Selected {name}")

        flow.connect("child-activated", lambda _flow, child: apply(child.wallpaper))

        # ---- Look: the selected spec wallpaper's settings, written to its JSON; the engine redraws live.
        look = Adw.PreferencesGroup(title="Look", description="Changes appear on your desktop as you make them.")
        page.add(look)
        look_rows, look_state = [], {"path": None, "spec": None, "defaults": {}, "loading": False, "pending": 0}

        def save_look():
            look_state["pending"] = 0
            path, spec = look_state["path"], look_state["spec"]
            if path and spec is not None:
                path.write_text(json.dumps(spec, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
                spec_html(path)
            return False

        def look_changed(key, value):
            if look_state["loading"] or look_state["spec"] is None:
                return
            spec = look_state["spec"]
            if key.startswith("uniforms."):
                spec.setdefault("uniforms", {})[key[9:]] = value
            else:
                spec[key] = value
            if not look_state["pending"]:
                look_state["pending"] = GLib.timeout_add(150, save_look)

        def current(key, fallback):
            spec = look_state["spec"] or {}
            if key.startswith("uniforms."):
                return spec.get("uniforms", {}).get(key[9:], look_state["defaults"].get(key[9:], fallback))
            return spec.get(key, fallback)

        def slider_row(title, key, low, high, step, fallback, subtitle=None, media=True):
            row = Adw.ActionRow(title=title, subtitle=subtitle or "")
            scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, low, high, step)
            scale.set_size_request(240, -1); scale.set_draw_value(True); scale.set_valign(Gtk.Align.CENTER)
            scale.set_digits(0 if step >= 1 else 2)
            scale.connect("value-changed", lambda s: look_changed(key, round(s.get_value(), 2)))
            row.add_suffix(scale)
            look_rows.append((row, media, lambda: scale.set_value(float(current(key, fallback)))))
            look.add(row)

        def combo_row(title, key, labels, values, fallback, media=True, subtitle=None):
            row = Adw.ComboRow(title=title, subtitle=subtitle or "", model=Gtk.StringList.new(labels))
            def picked(r, _):
                look_changed(key, values[r.get_selected()])
            row.connect("notify::selected", picked)
            def load():
                value = current(key, fallback)
                row.set_selected(values.index(value) if value in values else 0)
            look_rows.append((row, media, load))
            look.add(row)

        def switch_row(title, key, subtitle, media=True):
            row = Adw.SwitchRow(title=title, subtitle=subtitle)
            row.connect("notify::active", lambda r, _: look_changed(key, 1 if r.get_active() else 0))
            look_rows.append((row, media, lambda: row.set_active(bool(current(key, 0)))))
            look.add(row)

        def color_row(title, key, fallback, media=True, subtitle=None):
            row = Adw.ActionRow(title=title, subtitle=subtitle or "")
            button = Gtk.ColorDialogButton(dialog=Gtk.ColorDialog(with_alpha=False), valign=Gtk.Align.CENTER)
            def picked(b, _):
                c = b.get_rgba()
                look_changed(key, "#%02x%02x%02x" % (round(c.red * 255), round(c.green * 255), round(c.blue * 255)))
            button.connect("notify::rgba", picked)
            def load():
                rgba = Gdk.RGBA(); rgba.parse(str(current(key, fallback))); button.set_rgba(rgba)
            row.add_suffix(button)
            look_rows.append((row, media, load))
            look.add(row)

        charset_names = list(CHARSETS)
        combo_row("Characters", "charset", [n.capitalize() for n in charset_names], [CHARSETS[n] for n in charset_names],
                  CHARSETS["classic"], media=False, subtitle="From light to dense")
        slider_row("Character size", "cell", 4, 24, 1, 8, media=False)
        combo_row("Weight", "weight", ["Light", "Regular", "Bold", "Heavy"], [300, 400, 700, 900], 400, media=False)
        slider_row("Glow", "fill", 0, 1, 0.05, 0, "Each character's colour, faintly, behind it", media=False)
        color_row("Background", "background", "#000000", media=False)
        combo_row("Colours", "uniforms.colorMode", ["The picture's own", "One colour", "Gradient"], [0, 1, 2], 0)
        color_row("Tint", "uniforms.tint", "#e8b900", subtitle="For dark or grey parts, and the one-colour and gradient modes")
        color_row("Second colour", "uniforms.tint2", "#ff3355", subtitle="The gradient's bright end")
        slider_row("Colour lift", "uniforms.vivid", 0, 1, 0.05, 0.5, "Brighten colours towards full strength")
        slider_row("Contrast", "uniforms.contrast", 0.2, 4, 0.05, 1)
        slider_row("Brightness", "uniforms.brightness", -1, 1, 0.05, 0)
        switch_row("Invert", "uniforms.invert", "Give the dense characters to the dark parts")
        switch_row("Fill the screen", "uniforms.fit", "Crop to cover the whole screen instead of showing everything")
        slider_row("Backdrop", "uniforms.backdrop", 0, 1, 0.05, 0.3, "A dim copy behind, where the picture doesn't reach")
        slider_row("Zoom", "uniforms.zoom", 0.5, 3, 0.05, 1)
        slider_row("Hover lens", "uniforms.lens", 0, 2, 0.1, 1, "Magnify around the pointer")
        slider_row("Click ripple", "uniforms.ripple", 0, 2, 0.1, 1)
        slider_row("Playback speed", "uniforms.speed", 0.1, 3, 0.05, 1)

        def load_look():
            path = spec_file(current_target) if current_target else None
            look.set_visible(bool(path))
            if not path:
                look_state.update(path=None, spec=None)
                return
            spec = read_spec(path)
            try:
                _, defaults = spec_shader(spec, path.parent)
            except (OSError, SystemExit):
                defaults = {}
            media = bool(spec.get("media"))
            look_state.update(path=path, spec=spec, defaults=defaults, loading=True)
            for row, media_only, load in look_rows:
                row.set_visible(media or not media_only)
                load()
            look_state["loading"] = False

        # ---- Performance.
        performance = Adw.PreferencesGroup(title="Performance")
        page.add(performance)
        renderer = Adw.ComboRow(title="Renderer", model=Gtk.StringList.new(["Native (lighter)", "Web (WebKit)"]),
                                subtitle="Built-in and ported wallpapers can run natively; HTML ones always use WebKit")
        renderer.set_selected(1 if engine_options.get("renderer") == "web" else 0)
        performance.add(renderer)
        def renderer_changed(row, _):
            set_engine_options({"renderer": "web" if row.get_selected() else "native"})
            show_wallpaper(app)
        renderer.connect("notify::selected", renderer_changed)

        scales = {}
        for key, title, subtitle, low, high, step in (
                ("fps", "Frame rate", "While the pointer is on the desktop", 10, 60, 1),
                ("idleFps", "Idle frame rate", "The rest of the time: most of the day, this is the one that matters", 1, 60, 1),
                ("quality", "Render quality", "Pixel density; lower draws fewer pixels", 0.5, 2, 0.1),
                ("pointer", "Pointer response", "How strongly wallpapers react to the pointer", 0, 2, 0.1)):
            row = Adw.ActionRow(title=title, subtitle=subtitle)
            scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, low, high, step)
            scale.set_digits(0 if step >= 1 else 1); scale.set_draw_value(True); scale.set_size_request(240, -1)
            scale.set_valign(Gtk.Align.CENTER)
            scale.set_value(engine_options[key])
            row.add_suffix(scale)
            performance.add(row)
            scales[key] = scale
        def options_changed(*_):
            set_engine_options({"fps": round(scales["fps"].get_value()), "idleFps": round(scales["idleFps"].get_value()),
                                "quality": round(scales["quality"].get_value(), 1),
                                "pointer": round(scales["pointer"].get_value(), 1)})
        for scale in scales.values():
            scale.connect("value-changed", options_changed)
        usage = Adw.ActionRow(title="Engine CPU", subtitle="Measuring…")
        recommend = Gtk.Button(label="Use lighter settings", valign=Gtk.Align.CENTER, sensitive=False)
        usage.add_suffix(recommend)
        performance.add(usage)
        cpu_state = {"baseline": (None, None), "cpu": 0.0}

        def refresh_cpu():
            if studio_window_ref is not win:
                return False   # the Studio was closed
            root = os.getpid()
            if not views and not engine["process"] and service_elsewhere():   # the service draws; measure it
                root = int(subprocess.run(["systemctl", "--user", "show", "-p", "MainPID", "--value", SERVICE],
                                          capture_output=True, text=True).stdout.strip() or 0) or root
            cpu, cpu_state["baseline"] = app_process_cpu(root, cpu_state["baseline"])
            cpu_state["cpu"] = cpu
            verdict = ("high" if cpu > 35 else "moderate" if cpu > 18 else "light")
            usage.set_subtitle(f"{cpu:.1f}% of one core: {verdict}")
            recommend.set_sensitive(cpu > 18)
            return True

        def lighter(*_):
            scales["fps"].set_value(min(engine_options["fps"], 20))
            scales["idleFps"].set_value(min(engine_options["idleFps"], 10))
            if cpu_state["cpu"] > 35:
                scales["quality"].set_value(max(0.5, round(engine_options["quality"] * 0.8, 1)))
        recommend.connect("clicked", lighter)
        GLib.timeout_add_seconds(2, refresh_cpu)

        # ---- Share.
        share = Adw.PreferencesGroup(title="Share and edit")
        page.add(share)
        export_row = Adw.ActionRow(title="Export for Windows and macOS",
                                   subtitle="One ZIP for Wallpaper Engine, Lively Wallpaper or Plash", activatable=True)
        export_row.add_suffix(Gtk.Image(icon_name="document-save-symbolic"))
        share.add(export_row)
        video_row = Adw.ActionRow(title="Save as a video or GIF", activatable=True,
                                  subtitle="For video wallpapers (GNOME, phones) or to share. Not for HTML wallpapers")
        video_row.add_suffix(Gtk.Image(icon_name="camera-video-symbolic"))
        share.add(video_row)
        edit_row = Adw.ActionRow(title="Open in your editor", subtitle="Wallpapers you made or ported", activatable=True)
        edit_row.add_suffix(Gtk.Image(icon_name="document-edit-symbolic"))
        share.add(edit_row)
        delete_row = Adw.ActionRow(title="Delete this wallpaper", activatable=True)
        delete_row.add_css_class("error")
        share.add(delete_row)

        def selected_name():
            chosen = flow.get_selected_children()
            return chosen[0].wallpaper if chosen else current_target

        def user_file(name):
            for suffix in (".json", ".html"):
                if re.fullmatch(NAME_RE, name) and (USER_WALLPAPERS / f"{name}{suffix}").is_file():
                    return USER_WALLPAPERS / f"{name}{suffix}"
            return None

        def export_selected(*_):
            name = selected_name()
            dialog = Gtk.FileDialog(title="Export wallpaper", initial_name=f"{name}.asciipaper.zip")
            def done(d, result):
                try:
                    target = d.save_finish(result)
                except GLib.Error:
                    return
                try:
                    toast(f"Exported {export_web(name, target.get_path()).name}")
                except (OSError, ValueError, RuntimeError, SystemExit) as error:
                    toast(f"Could not export: {getattr(error, 'code', None) or error}")
            dialog.save(win, None, done)
        export_row.connect("activated", export_selected)

        def video_selected(*_):
            name = selected_name()
            if not engine_args(name):
                toast("Videos can be made from built-in, ported and shader wallpapers")
                return
            dialog = Gtk.FileDialog(title="Save as a video or GIF", initial_name=f"{name}.mp4")
            def done(d, result):
                try:
                    target = d.save_finish(result).get_path()
                except GLib.Error:
                    return
                toast("Rendering… this takes a little while")
                def work():
                    try:
                        message = f"Saved {render_video(name, target).name}"
                    except SystemExit as error:
                        message = str(error.code)
                    GLib.idle_add(lambda: toast(message) and False)
                threading.Thread(target=work, daemon=True).start()
            dialog.save(win, None, done)
        video_row.connect("activated", video_selected)

        def edit_selected(*_):
            path = user_file(selected_name())
            if not path:
                toast("Built-in wallpapers are read-only. Add a shader wallpaper to start your own.")
                return
            Gio.AppInfo.launch_default_for_uri(path.as_uri(), None)
        edit_row.connect("activated", edit_selected)

        def delete_selected(*_):
            name = selected_name()
            path = user_file(name)
            if not path:
                toast("Built-in wallpapers can't be deleted.")
                return
            confirm = Adw.AlertDialog(heading=f"Delete {name}?", body="Its file and any ported media are removed.")
            confirm.add_response("cancel", "Cancel"); confirm.add_response("delete", "Delete")
            confirm.set_response_appearance("delete", Adw.ResponseAppearance.DESTRUCTIVE)
            def answered(_dialog, response):
                if response != "delete":
                    return
                if path.suffix == ".json":
                    media = read_spec(path).get("media")
                    if isinstance(media, str) and not Path(media).is_absolute():
                        for file in ((path.parent / media), Path(f"{path.parent / media}.frames")):
                            if file.resolve().is_relative_to(USER_WALLPAPERS.resolve()):
                                file.unlink(missing_ok=True)
                    path.with_suffix(".html").unlink(missing_ok=True)
                path.unlink(missing_ok=True)
                if name == current_target:
                    apply(DEFAULT)
                refresh_gallery()
                toast(f"Deleted {name}")
            confirm.connect("response", answered)
            confirm.present(win)
        delete_row.connect("activated", delete_selected)

        def track_selection(*_):
            video_row.set_sensitive(bool(engine_args(selected_name())))
            own = bool(user_file(selected_name()))
            edit_row.set_sensitive(own); delete_row.set_sensitive(own)
        flow.connect("selected-children-changed", track_selection)

        # ---- Adding wallpapers.
        def port(source, name=None):
            toast("Porting… this takes a few seconds")
            def work():
                try:
                    result = import_media(source, name)
                except SystemExit as error:
                    result = RuntimeError(str(error.code))
                except (OSError, ValueError, urllib.error.URLError) as error:
                    result = error
                GLib.idle_add(ported, result)
            threading.Thread(target=work, daemon=True).start()

        def ported(result):
            if isinstance(result, Exception):
                toast(f"Could not port it: {result}")
                return False
            refresh_gallery(select=result)
            apply(result)
            return False

        def port_file(*_):
            dialog = Gtk.FileDialog(title="Port a picture, GIF or video")
            media_filter = Gtk.FileFilter(name="Pictures, GIFs and videos")
            media_filter.add_mime_type("image/*"); media_filter.add_mime_type("video/*")
            filters = Gio.ListStore.new(Gtk.FileFilter); filters.append(media_filter)
            dialog.set_filters(filters)
            def done(d, result):
                try:
                    port(d.open_finish(result).get_path())
                except GLib.Error:
                    pass
            dialog.open(win, None, done)

        def port_link(*_):
            ask = Adw.AlertDialog(heading="Port from a link", body="A post on X or Twitter, or a direct link to a picture, GIF or video.")
            entry = Gtk.Entry(placeholder_text="https://x.com/…/status/…", activates_default=True)
            ask.set_extra_child(entry)
            ask.add_response("cancel", "Cancel"); ask.add_response("port", "Port")
            ask.set_response_appearance("port", Adw.ResponseAppearance.SUGGESTED)
            ask.set_default_response("port")
            def answered(_dialog, response):
                link = entry.get_text().strip()
                if response == "port" and re.match(r"https?://", link):
                    port(link)
                elif response == "port":
                    toast("That doesn't look like a link")
            ask.connect("response", answered)
            ask.present(win)

        def ask_name(heading, callback):
            ask = Adw.AlertDialog(heading=heading, body="Letters, numbers, spaces, _ and -")
            entry = Gtk.Entry(placeholder_text="my-wallpaper", activates_default=True)
            ask.set_extra_child(entry)
            ask.add_response("cancel", "Cancel"); ask.add_response("ok", "Create")
            ask.set_response_appearance("ok", Adw.ResponseAppearance.SUGGESTED)
            ask.set_default_response("ok")
            def answered(_dialog, response):
                name = entry.get_text().strip()
                if response != "ok":
                    return
                if not re.fullmatch(NAME_RE, name) or name in PRESETS or user_file(name):
                    toast("Choose a new name: letters, numbers, spaces, _ and -")
                    return
                callback(name)
            ask.connect("response", answered)
            ask.present(win)

        def new_shader(*_):
            def create(name):
                USER_WALLPAPERS.mkdir(parents=True, exist_ok=True)
                shutil.copyfile(LOCAL / "starter.glsl", USER_WALLPAPERS / f"{name}.glsl")
                spec = {"title": name, "shader": f"{name}.glsl", "charset": CHARSETS["asciify"], "cell": 10,
                        "aspect": 0.6, "background": "#080909", "fill": 0.1, "uniforms": {"speed": 1}}
                path = USER_WALLPAPERS / f"{name}.json"
                path.write_text(json.dumps(spec, indent=2) + "\n", encoding="utf-8")
                ensure_user_api(); spec_html(path)
                refresh_gallery(select=name); apply(name)
                Gio.AppInfo.launch_default_for_uri((USER_WALLPAPERS / f"{name}.glsl").as_uri(), None)
                toast("Edit the .glsl file: every save shows on your desktop")
            ask_name("New shader wallpaper", create)

        def import_html(*_):
            dialog = Gtk.FileDialog(title="Import an HTML wallpaper")
            html_filter = Gtk.FileFilter(name="HTML files"); html_filter.add_pattern("*.html"); html_filter.add_pattern("*.htm")
            filters = Gio.ListStore.new(Gtk.FileFilter); filters.append(html_filter)
            dialog.set_filters(filters)
            def done(d, result):
                try:
                    source = Path(d.open_finish(result).get_path())
                except (GLib.Error, TypeError):
                    return
                stem = re.sub(r"[^A-Za-z0-9 _-]", "", source.stem).strip()[:40] or "imported"
                name, index = stem, 2
                while name in PRESETS or user_file(name):
                    name, index = f"{stem} {index}", index + 1
                try:
                    USER_WALLPAPERS.mkdir(parents=True, exist_ok=True)
                    ensure_user_api()
                    copy_local_assets(source, USER_WALLPAPERS)
                    shutil.copy2(source, USER_WALLPAPERS / f"{name}.html")
                except (OSError, ValueError) as error:
                    toast(f"Could not import: {error}")
                    return
                refresh_gallery(select=name); apply(name)
            dialog.open(win, None, done)

        for action_name, handler in (("port-file", port_file), ("port-link", port_link), ("import-html", import_html),
                                     ("new-shader", new_shader),
                                     ("open-folder", lambda *_: (USER_WALLPAPERS.mkdir(parents=True, exist_ok=True),
                                                                 Gio.AppInfo.launch_default_for_uri(USER_WALLPAPERS.as_uri(), None)))):
            action = Gio.SimpleAction.new(action_name, None)
            action.connect("activate", handler)
            win.add_action(action)

        drop = Gtk.DropTarget.new(Gdk.FileList, Gdk.DragAction.COPY)
        def dropped(_target, files, *_):
            for file in files.get_files():
                if file.get_path():
                    port(file.get_path())
            return True
        drop.connect("drop", dropped)
        win.add_controller(drop)

        def pause_toggled(button):
            if button.get_active():
                close_views(); stop_engine()
                if service_elsewhere():
                    subprocess.run(["systemctl", "--user", "stop", SERVICE])
                toast("Wallpaper paused")
            else:
                show_wallpaper(app)
        pause_button.connect("toggled", pause_toggled)

        refresh_gallery()
        load_look()
        track_selection()
        win.present()
        if os.environ.get("ASCIIPAPER_STUDIO_SNAPSHOT"):   # docs and tests: save the window as a PNG, then quit
            win.set_default_size(1000, int(os.environ.get("ASCIIPAPER_STUDIO_SNAPSHOT_HEIGHT", "860")))
            def scroll():   # ASCIIPAPER_STUDIO_SNAPSHOT_SCROLL=0..1: how far down the page to capture
                scroller = page.get_first_child()
                while scroller and not isinstance(scroller, Gtk.ScrolledWindow):
                    scroller = scroller.get_first_child()
                if scroller:
                    adj = scroller.get_vadjustment()
                    adj.set_value((adj.get_upper() - adj.get_page_size()) * float(os.environ.get("ASCIIPAPER_STUDIO_SNAPSHOT_SCROLL", "0")))
                return False
            GLib.timeout_add_seconds(3, scroll)
            def snap():
                content, node = win.get_content(), Gtk.Snapshot()
                width, height = content.get_width(), content.get_height()
                bg = Gdk.RGBA(); bg.parse("#242424" if Adw.StyleManager.get_default().get_dark() else "#fafafa")
                node.append_color(bg, Graphene.Rect().init(0, 0, width, height))
                Gtk.WidgetPaintable.new(content).get_current_image().snapshot(node, width, height)
                rendered = node.to_node()
                if rendered:
                    win.get_renderer().render_texture(rendered, None).save_to_png(os.environ["ASCIIPAPER_STUDIO_SNAPSHOT"])
                app.quit()
                return False
            GLib.timeout_add_seconds(int(os.environ.get("ASCIIPAPER_STUDIO_SNAPSHOT_DELAY", "8")), snap)

    def command_line(app, command_line):
        args = command_line.get_arguments()[1:]
        if preview:
            preview_window(app)
        elif studio or "--studio" in args:
            if not service_elsewhere():
                show_wallpaper(app)
            studio_window(app)
        else:
            # Gtk.Application forwards later CLI launches to this one running
            # instance. Apply the requested preset here instead of starting a
            # competing background surface in a second process.
            if args:
                set_target(args[0])
            show_wallpaper(app)
        if not layer_supported and not studio and not preview and "--studio" not in args:
            app.quit()
        command_line.set_exit_status(0)
        return 0

    app.connect("command-line", command_line)
    app.run(sys.argv)


def set_wallpaper(target):
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    CONFIG.write_text(target + "\n")
    if not FLATPAK:
        subprocess.run(["systemctl", "--user", "restart", SERVICE])
    else:
        print("Saved. Apply it with: flatpak kill io.github.cyoren.asciipaper, then launch asciipaper again.")


def main():
    args = sys.argv[1:]
    if args in (["--version"], ["-v"]):
        print(f"asciipaper {VERSION}")
    elif args[:1] == ["list"]:
        print("\n".join(library()))
    elif args[:1] == ["import"] and len(args) in {2, 3}:
        if len(args) == 3 and not re.fullmatch(NAME_RE, args[2]):
            sys.exit("asciipaper: names use letters, numbers, spaces, _ and - (up to 48 characters)")
        name = import_media(args[1], args[2] if len(args) == 3 else None)
        print(f"Created {USER_WALLPAPERS / (name + '.json')}\n"
              f"Change its look in the Studio (asciipaper --studio) or by editing that file; it updates live.")
        set_wallpaper(name)
    elif args[:1] == ["create"] and len(args) in {2, 3} and args[2:] in ([], ["--html"]):
        name = args[1]
        if not re.fullmatch(NAME_RE, name):
            sys.exit("Usage: asciipaper create <name> [--html]  (letters, numbers, spaces, _ and -; up to 48 characters)")
        if name in PRESETS or (USER_WALLPAPERS / f"{name}.json").exists() or (USER_WALLPAPERS / f"{name}.html").exists():
            sys.exit(f"asciipaper: {name!r} already exists; choose another name")
        USER_WALLPAPERS.mkdir(parents=True, exist_ok=True)
        ensure_user_api()
        if args[2:] == ["--html"]:
            destination = USER_WALLPAPERS / f"{name}.html"
            shutil.copyfile(LOCAL / "starter.html", destination)
        else:   # a shader wallpaper: runs natively and on the web
            shutil.copyfile(LOCAL / "starter.glsl", USER_WALLPAPERS / f"{name}.glsl")
            spec = {"title": name, "shader": f"{name}.glsl", "charset": CHARSETS["asciify"], "cell": 10,
                    "aspect": 0.6, "background": "#080909", "fill": 0.1, "uniforms": {"speed": 1}}
            (USER_WALLPAPERS / f"{name}.json").write_text(json.dumps(spec, indent=2) + "\n", encoding="utf-8")
            spec_html(USER_WALLPAPERS / f"{name}.json")
            destination = USER_WALLPAPERS / f"{name}.glsl"
        print(f"Created {destination}\nTry it: asciipaper '{name}'   Keep it: asciipaper set '{name}'\n"
              f"Edits show live while it runs.")
    elif args[:1] == ["render"] and len(args) >= 3:
        options = dict(zip(args[3::2], args[4::2]))
        if len(args[3:]) % 2 or set(options) - {"--seconds", "--size"}:
            sys.exit("Usage: asciipaper render <wallpaper> <output.mp4|webm|gif> [--seconds S] [--size WxH]")
        try:
            seconds = float(options["--seconds"]) if "--seconds" in options else None
        except ValueError:
            sys.exit("asciipaper: --seconds takes a number")
        print(f"Created {render_video(args[1], args[2], seconds, options.get('--size'))}")
    elif args[:1] == ["export"] and len(args) in {2, 3, 4}:
        rest = args[2:] if args[1] == "lively" else args[1:]   # `export lively` is the old spelling
        if not rest or len(rest) > 2:
            sys.exit("Usage: asciipaper export <wallpaper> [output.zip]")
        output = export_web(rest[0], rest[1] if len(rest) == 2 else None)
        print(f"Created {output}\nWindows: open project.json in Wallpaper Engine, or drag the ZIP onto Lively.\n"
              f"macOS: unzip and add index.html to Plash.")
    elif args[:1] == ["set"]:
        if len(args) != 2:
            sys.exit(__doc__)
        resolve(args[1])
        set_wallpaper(args[1])
    elif args[:1] == ["preview"] and len(args) == 2:
        run(args[1], preview=True)
    elif args == ["--studio"]:
        run(CONFIG.read_text().strip() if CONFIG.exists() else DEFAULT, studio=True)
    elif not args:
        run(CONFIG.read_text().strip() if CONFIG.exists() else DEFAULT)
    elif len(args) == 1 and not args[0].startswith("-"):
        run(args[0])
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
