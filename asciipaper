      "size": {"type": "string", "description": "WxH, default 960x540"}}, ["name"]),
    ("set_wallpaper", "Show a wallpaper on the desktop (saves the choice and restarts the service).",
     {"name": {"type": "string", "description": "a wallpaper name, URL or .html path"}}, ["name"]),
    ("import_media", "Make a new wallpaper from a picture, GIF, video, URL, X/Twitter post, or a recipe code that carries a "
     "shader, without showing it yet.", {"source": {"type": "string"}, "name": {"type": "string"}}, ["source"]),
    ("text_wallpaper", "Make a wallpaper of big text (a word, a name, a few lines), drawn in characters; style it after.",
     {"text": {"type": "string"}, "name": {"type": "string"}}, ["text"]),
    ("encode_recipe", "A wallpaper's look (and a shader wallpaper's code) as one shareable asciipaper:v1: line.",
     {"name": {"type": "string"}}, ["name"]),
    ("decode_recipe", "Read an asciipaper:v1: recipe code as JSON.", {"code": {"type": "string"}}, ["code"]),
    ("render", "Save a wallpaper as a PNG still (up to 7680x4320, carrying its recipe) or a video or GIF (by the output's "
     "extension: png, mp4, webm, mkv, mov, gif).",
     {"name": {"type": "string"}, "output": {"type": "string"}, "seconds": {"type": "number"},
      "size": {"type": "string", "description": "WxH"}}, ["name", "output"]),
]


def mcp_call(tool, a):
    """Run one MCP tool; return MCP content blocks."""
    text = lambda s: [{"type": "text", "text": s}]
    image = lambda png: [{"type": "image", "mimeType": "image/png", "data": __import__("base64").b64encode(png).decode()}]
    if tool == "list_wallpapers":
        current = CONFIG.read_text().strip() if CONFIG.exists() else DEFAULT
        return text(json.dumps({"showing": current, "wallpapers": library()}))
    if tool == "get_wallpaper":
        spec = spec_file(a["name"])
        if not spec:
            raise ValueError(f"{a['name']!r} is a preset or HTML wallpaper; only shader and ported wallpapers have a spec"
                             if a["name"] in library() else f"no wallpaper named {a['name']!r}")
        data = read_spec(spec)
        return text(json.dumps({"spec": data, "shader": spec_shader(data, spec.parent)[0]}, ensure_ascii=False))
    if tool == "list_styles":
        return text(json.dumps({"styles": {k: v[0] for k, v in STYLES.items()}, "shapes": SHAPES, "charsets": CHARSETS,
                                "dithers": DITHERS + sorted(DIFFUSION), "palettes": PALETTES,
                                "effects": {k: list(v) for k, v in EFFECTS.items()}, "warps": WARPS}, ensure_ascii=False))
    if tool == "write_wallpaper":
        look = a.get("look") or {}
        name = (restyle(a["name"], recipe_look(a["recipe"])) if a.get("recipe") else a["name"])
        name = write_wallpaper(name, a.get("shader"), look) if a.get("shader") or look or not a.get("recipe") else name
        try:
            return text(f"Saved {name}.") + image(snapshot_png(name))
        except (ValueError, subprocess.TimeoutExpired) as error:
            return text(f"Saved {name}, but it doesn't render: {error}")
    if tool == "text_wallpaper":
        name = text_wallpaper(a["text"], a.get("name"))
        return text(f"Created {name}.") + image(snapshot_png(name))
    if tool == "encode_recipe":
        spec = spec_file(a["name"])
        if not spec:
            raise ValueError(f"{a['name']!r} has no look to share (only shader and ported wallpapers do)")
        return text(encode_recipe(read_spec(spec), spec.parent))
    if tool == "decode_recipe":
        return text(json.dumps(decode_recipe(a["code"]), ensure_ascii=False))
    if tool == "snapshot":
        return image(snapshot_png(a["name"], a.get("seconds", 3), a.get("size", "960x540")))
    if tool == "set_wallpaper":
        resolve(a["name"])
        set_wallpaper(a["name"])
        return text(f"Showing {a['name']}.")
    if tool == "import_media":
        if a.get("name") and not re.fullmatch(NAME_RE, a["name"]):
            raise ValueError("names use letters, numbers, spaces, _ and - (up to 48 characters)")
        name = (import_recipe(a["source"], a.get("name")) if a["source"].startswith(RECIPE)
                else import_media(a["source"], a.get("name")))
        return text(f"Created {name}.") + image(snapshot_png(name))
    if tool == "render":
        if a["output"].lower().endswith(".png"):
            return text(f"Created {render_png(a['name'], a['output'], a.get('seconds', 3), a.get('size'))}")
        return text(f"Created {render_video(a['name'], a['output'], a.get('seconds'), a.get('size'))}")
    raise ValueError(f"unknown tool {tool}")


def mcp():
    """A stdio MCP server, so Claude, Cursor or any MCP client can design and switch wallpapers."""
    out = os.fdopen(os.dup(1), "w", buffering=1)
    os.dup2(2, 1)   # anything else printed (here or by child processes) goes to stderr, not into the protocol
    tools = [{"name": n, "description": d, "inputSchema": {"type": "object", "properties": p, "required": r}}
             for n, d, p, r in MCP_TOOLS]
    for line in sys.stdin:
        try:
            message = json.loads(line)
        except ValueError:
            continue
        method, params = message.get("method"), message.get("params") or {}
        if "id" not in message:
            continue   # a notification
        reply = {"jsonrpc": "2.0", "id": message["id"]}
        if method == "initialize":
            reply["result"] = {"protocolVersion": params.get("protocolVersion", "2025-06-18"), "capabilities": {"tools": {}},
                               "serverInfo": {"name": "asciipaper", "version": VERSION}}
        elif method == "ping":
            reply["result"] = {}
        elif method == "tools/list":
            reply["result"] = {"tools": tools}
        elif method == "tools/call":
            try:
                reply["result"] = {"content": mcp_call(params.get("name"), params.get("arguments") or {})}
            except SystemExit as error:   # the CLI's helpers exit with a message
                reply["result"] = {"content": [{"type": "text", "text": str(error.code)}], "isError": True}
            except (ValueError, KeyError, OSError, subprocess.TimeoutExpired) as error:
                reply["result"] = {"content": [{"type": "text", "text": f"asciipaper: {error}"}], "isError": True}
        else:
            reply["error"] = {"code": -32601, "message": f"unknown method {method}"}
        out.write(json.dumps(reply) + "\n")


def main():
    args = sys.argv[1:]
    if args in (["--version"], ["-v"]):
        print(f"asciipaper {VERSION}")
    elif args == ["mcp"]:
        mcp()
    elif args[:1] == ["list"]:
        print("\n".join(library()))
    elif args == ["styles"]:
        width = max(map(len, STYLES))
        print("\n".join(f"{name:<{width}}  {about}" for name, (about, _) in STYLES.items()))
        print(f"\nshapes: {' '.join(SHAPES)}\ncharsets: {' '.join(CHARSETS)}\ndithers: {' '.join(DITHERS)}\n"
              f"palettes: {' '.join(PALETTES)}\neffects (0..1; saturation -1..1, hue -0.5..0.5): {' '.join(EFFECTS)}\n"
              f"warps (ported media): {' '.join(WARPS)}")
    elif args[:1] == ["look"] and len(args) >= 3:
        look = {}
        for arg in args[2:]:
            key, sep, value = arg.partition("=")
            if not sep:
                look = {**look, **recipe_look(arg)}
                continue
            try:
                value = json.loads(value)
            except ValueError:
                pass
            group, dot, sub = key.partition(".")
            if dot:
                look.setdefault(group, {})[sub] = value
            else:
                look[key] = value
        name = restyle(args[1], normalize_look(look))
        print(f"Restyled {name}" + ("" if name == args[1] else f" (your copy of {args[1]})"))
    elif args[:1] == ["recipe"] and len(args) == 2:
        name, path = args[1], spec_file(args[1])
        if not path:
            sys.exit(f"asciipaper: {name!r} has no look to share (only shader and ported wallpapers do)")
        print(encode_recipe(read_spec(path), path.parent))
    elif args[:1] == ["text"] and len(args) in {2, 3}:
        name = text_wallpaper(args[1], args[2] if len(args) == 3 else None)
        print(f"Created {name}; restyle it: asciipaper look '{name}' lego")
        set_wallpaper(name)
    elif args[:1] == ["import"] and len(args) in {2, 3}:
        if len(args) == 3 and not re.fullmatch(NAME_RE, args[2]):
            sys.exit("asciipaper: names use letters, numbers, spaces, _ and - (up to 48 characters)")
        code = args[1] if args[1].startswith(RECIPE) else None
        if not code and args[1].lower().endswith(".png") and Path(args[1]).expanduser().is_file():
            code = png_recipe(Path(args[1]).expanduser())
            code = code if code and "shader" in decode_recipe(code) else None
        if code:
            name = import_recipe(code, args[2] if len(args) == 3 else None)
            print(f"Created {name}")
            set_wallpaper(name)
            return
        name = import_media(args[1], args[2] if len(args) == 3 else None)
        print(f"Created {USER_WALLPAPERS / (name + '.json')}\n"
              f"Change its look in the Studio (asciipaper --studio) or by editing that file; it updates live.")
        set_wallpaper(name)
    elif args[:1] == ["create"] and len(args) in {2, 3} and args[2:] in ([], ["--html"]):
        name = args[1]
        if not re.fullmatch(NAME_RE, name):
            sys.exit("Usage: asciipaper create <name> [--html]  (letters, numbers, spaces, _ and -; up to 48 characters)")
        if taken(name):
            sys.exit(f"asciipaper: {name!r} already exists; choose another name")
        USER_WALLPAPERS.mkdir(parents=True, exist_ok=True)
        ensure_user_api()
        if args[2:] == ["--html"]:
            destination = USER_WALLPAPERS / f"{name}.html"
            shutil.copyfile(LOCAL / "starter.html", destination)
        else:   # a shader wallpaper: runs natively and on the web
            shutil.copyfile(LOCAL / "starter.glsl", USER_WALLPAPERS / f"{name}.glsl")
            spec = {"title": name, "shader": f"{name}.glsl", "charset": CHARSETS["asciify"], "cell": 10,
                    "aspect": 0.6, "background": "#080909", "fill": 0.1, "uniforms": {"speed": 1}}
            (USER_WALLPAPERS / f"{name}.json").write_text(json.dumps(spec, indent=2) + "\n", encoding="utf-8")
            spec_html(USER_WALLPAPERS / f"{name}.json")
            destination = USER_WALLPAPERS / f"{name}.glsl"
        print(f"Created {destination}\nShow it: asciipaper set '{name}'   (saving your edits updates it live)")
    elif args[:1] == ["render"] and len(args) >= 3:
        options = dict(zip(args[3::2], args[4::2]))
        if len(args[3:]) % 2 or set(options) - {"--seconds", "--size"}:
            sys.exit("Usage: asciipaper render <wallpaper> <output.png|mp4|webm|gif> [--seconds S] [--size WxH]")
        try:
            seconds = float(options["--seconds"]) if "--seconds" in options else None
        except ValueError:
            sys.exit("asciipaper: --seconds takes a number")
        if args[2].lower().endswith(".png"):
            print(f"Created {render_png(args[1], args[2], seconds or 3.0, options.get('--size'))}")
        else:
            print(f"Created {render_video(args[1], args[2], seconds, options.get('--size'))}")
    elif args[:1] == ["export"] and len(args) in {2, 3, 4}:
        rest = args[2:] if args[1] == "lively" else args[1:]   # `export lively` is the old spelling
        if not rest or len(rest) > 2:
            sys.exit("Usage: asciipaper export <wallpaper> [output.zip]")
        output = export_web(rest[0], rest[1] if len(rest) == 2 else None)
        print(f"Created {output}\nWindows: open project.json in Wallpaper Engine, or drag the ZIP onto Lively.\n"
              f"macOS: unzip and add index.html to Plash.")
    elif args[:1] == ["set"]:
        if len(args) != 2:
            sys.exit(__doc__)
        resolve(args[1])
        set_wallpaper(args[1])
    elif args[:1] == ["preview"] and len(args) == 2:
        run(args[1], preview=True)
    elif args == ["--studio"]:
        run(CONFIG.read_text().strip() if CONFIG.exists() else DEFAULT, studio=True)
    elif not args:
        run(CONFIG.read_text().strip() if CONFIG.exists() else DEFAULT)
    elif len(args) == 1 and not args[0].startswith("-"):
        run(args[0])
    else:
        sys.exit(__doc__)


def run_main():
    try:
        main()
    except ValueError as error:
        sys.exit(f"asciipaper: {error}")


if __name__ == "__main__":
    run_main()
