def snapshot_png(target, seconds=3.0, size="960x540"):
    """One PNG frame of a wallpaper via asciipaper-engine; raises with the engine's error (e.g. a shader that won't compile)."""
    args = engine_args(target)
    if not args:
        raise ValueError("snapshots work with the built-in presets and with ported or shader wallpapers")
    if not re.fullmatch(r"\d{2,4}x\d{2,4}", size) or max(map(int, size.split("x"))) > 7680:
        raise ValueError("size is WIDTHxHEIGHT up to 7680x4320, e.g. 960x540")
    with tempfile.TemporaryDirectory(prefix="asciipaper-snap-") as folder:
        png = Path(folder) / "snap.png"
        done = subprocess.run([*args, "--snapshot", str(png), "--size", size, "--seconds", str(float(seconds))],
                              capture_output=True, text=True, env=engine_env(), timeout=120)
        if done.returncode or not png.is_file():
            raise ValueError(done.stderr.strip() or "engine error")
        return png.read_bytes()


def write_wallpaper(name, shader=None, look=None):
    """Create or update the user's shader wallpaper NAME from GLSL and/or spec fields; it updates live if showing."""
    if not re.fullmatch(NAME_RE, name):
        raise ValueError("names use letters, numbers, spaces, _ and - (up to 48 characters)")
    path = USER_WALLPAPERS / f"{name}.json"
    if not path.exists() and taken(name):
        if shader or not spec_file(name):
            raise ValueError(f"{name!r} is built in; pick another name")
        return restyle(name, normalize_look(look or {}))   # restyling a built-in: the user's copy
    if not path.exists() and not shader:
        raise ValueError("a new wallpaper needs a shader")
    if look is not None and not isinstance(look, dict):
        raise ValueError("look is an object of spec fields")
    look = normalize_look(look or {})
    spec = read_spec(path) if path.exists() else {"title": name, "charset": CHARSETS["asciify"], "cell": 10,
                                                  "aspect": 0.6, "background": "#080909", "fill": 0.1, "uniforms": {}}
    apply_look(spec, look)
    USER_WALLPAPERS.mkdir(parents=True, exist_ok=True)
    ensure_user_api()
    if shader:
        (USER_WALLPAPERS / f"{name}.glsl").write_text(shader, encoding="utf-8")
        spec["shader"] = f"{name}.glsl"
    path.write_text(json.dumps(spec, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    spec_html(path)
    return name


def with_text(png, key, text):
    """A PNG with a tEXt chunk added before IEND (other tools ignore it)."""
    body = key.encode("latin-1") + b"\0" + text.encode("latin-1")
    chunk = struct.pack(">I", len(body)) + b"tEXt" + body + struct.pack(">I", zlib.crc32(b"tEXt" + body))
    end = png.rindex(b"IEND") - 4
    return png[:end] + chunk + png[end:]


def render_png(target, output, seconds=3.0, size=None):
    """A still at up to 8K, remembering its look: `asciipaper look NAME this.png` (or import, for shaders) brings it back."""
    png = snapshot_png(target, seconds, size or "3840x2160")
    spec = spec_file(target)
    if spec:
        png = with_text(png, "asciipaperRecipe", encode_recipe(read_spec(spec), spec.parent))
    output = Path(output).expanduser().resolve()
    output.write_bytes(png)
    return output


